{
  "name": "todo-test",
  "version": "1.0.0",
  "description": "Небольшой todo проект для тестирования mauli",
  "scripts": {
    "check-env": "node src/config.js",
    "start": "node src/config.js && http-server . -p 3000 -o",
    "dev": "node src/config.js && http-server . -p 3000",
    "lint": "eslint .",
    "test": "node scripts/run-tests.js tests",
    "test:integration": "node scripts/run-tests.js tests/integration",
    "test:tia": "node scripts/test-impact-analysis.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  }
}
